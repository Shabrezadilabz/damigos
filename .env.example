# Copy to .env at repo root (local). Stage/prod: set same keys on the host / secret manager.
# Never commit real DEEPSEEK_API_KEY.

# local | staging | production
DAMIGOS_ENV=local

DATABASE_URL=postgresql://damigos:damigos@localhost:5432/damigos
REDIS_URL=redis://localhost:6379
# Max concurrent SSE/WS kitchen connections per restaurant (default 32)
KITCHEN_STREAM_MAX_PER_RESTAURANT=32

GUEST_WEB_URL=http://localhost:3000
CRM_WEB_URL=http://localhost:3001
GUEST_API_URL=http://localhost:4000
CRM_API_URL=http://localhost:4001

JWT_SECRET=change-me-in-production-min-32-chars
OTP_BYPASS_CODE=000000
DEV_OWNER_PHONE=9876543210
DEV_ADMIN_PHONE=9876543211
DEV_GUEST_PHONE=9123456780
DEV_GUEST_SPIN_PHONE=9123456781
DEV_GUEST_REWARD_PHONE=9123456782
DEV_GUEST_SCRATCH_PHONE=9123456783
DEV_ORDERING_ENABLED=true
ENABLE_DEV_FIXTURES=true
# Testing: new /start signups create tenant + owner role immediately (off in production unless true)
ONBOARDING_AUTO_APPROVE=true
REWARDS_DAILY_SPIN_LIMIT=1
DELIVERY_MODE=off
# DELIVERY_MODE=mock — local fake rates (560xxx Bangalore)
# DELIVERY_MODE=sandbox|live — Shiprocket External API (food: prefer Instant/local; Quick when enabled)
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_API_BASE=https://apiv2.shiprocket.in/v1/external
# SHIPROCKET_PICKUP_POSTCODE=560034
# SHIPROCKET_PICKUP_LOCATION=Primary
# Optional webhook token for POST {GUEST_API}/v1/webhooks/shiprocket
# SHIPROCKET_WEBHOOK_TOKEN=
# See docs/architecture/SHIPROCKET-RAZORPAY-SETUP.md

# CRM WhatsApp wallet top-up (pilot stub credits ledger immediately)
# stub = instant credit | live = Razorpay Checkout then credit (needs RAZORPAY_*)
WALLET_TOPUP_MODE=live

# Restaurant EOD settlement (after 12:00 AM IST → previous day invoice)
SETTLEMENT_SCHEDULER_ENABLED=true
# SETTLEMENT_SCHEDULER_INTERVAL_MS=60000
# Sticker print requests + settlement alerts → partners inbox
PARTNERS_NOTIFY_EMAIL=partners@damigos.in
# PARTNER_NOTIFY_WEBHOOK_URL=
# RESEND_API_KEY=          # required for live email + sample QR attachments
# RESEND_FROM=Damigos Ops <ops@damigos.in>

# Dual WhatsApp agents via Kapso Meta Proxy (see docs/architecture/KAPSO-AGENTS.md)
# mock = log only | live = POST api.kapso.ai/meta/whatsapp | off = disable sends
KAPSO_MODE=mock
# KAPSO_API_KEY=   # Kapso → Integrations → API keys (never commit)
#
# --- Dual-number sandbox (recommended) ---
# Connect TWO WhatsApp numbers in Kapso, then:
# KAPSO_MODE=live
# KAPSO_SPARK_PHONE_NUMBER_ID=   # Spark by D'aMigo (opt-in / game / Grow)
# KAPSO_FOOD_PHONE_NUMBER_ID=    # D'aMigo Food (order confirm / HI / track)
# KAPSO_USE_SANDBOX=false        # keep false when using dedicated SPARK+FOOD ids
# KAPSO_PHONE_NUMBER_ID=         # optional shared fallback only
#
# Legacy single sandbox number (both agents share one id if SPARK/FOOD unset):
# KAPSO_USE_SANDBOX=true
# KAPSO_SANDBOX_PHONE_NUMBER_ID=
#
# Approved Meta templates (live only; mock uses free-form text)
# KAPSO_FOOD_TEMPLATE_ORDER_CONFIRMED=damigos_order_confirmed
# KAPSO_FOOD_TEMPLATE_TRACK_UPDATE=damigos_order_track
# KAPSO_WABA_ID=
# Public WhatsApp digits for wa.me deep link on Spark bridge (no +)
# KAPSO_SPARK_WA_E164=9198XXXXXXXX
# Webhook verify (GET /v1/wa/webhooks/kapso) — set same token in Kapso/Meta
# KAPSO_WEBHOOK_VERIFY_TOKEN=damigos-kapso-verify
# Claim-without-order Spark nudge (minutes after claim; set 0 for immediate in tests)
# SPARK_CLAIM_NUDGE_ENABLED=true
# SPARK_CLAIM_NUDGE_MINUTES=30
# SPARK_CLAIM_NUDGE_INTERVAL_MS=60000

# FSSAI license verify: stub | attestr | eko (see docs/architecture/FSSAI-VERIFICATION.md)
FSSAI_VERIFY_MODE=stub
FSSAI_STUB_ACTIVE_NUMBER=11521998000045
# ATTESTR_API_KEY=
# EKO_API_BASE=https://staging.eko.in
# EKO_DEVELOPER_KEY=
# EKO_SECRET=
# EKO_INITIATOR_ID=

# --- DeepSeek (menu vision + poster copy + poster image layout) ---
# Pilot: one key for local, staging, and production (see docs/architecture/ENVIRONMENTS.md)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_VISION=deepseek-flash
DEEPSEEK_MODEL_TEXT=deepseek-v4-pro
# DEEPSEEK_API_KEY_STAGING=
# DEEPSEEK_API_KEY_PRODUCTION=

MENU_IMPORT_MODE=mock
MENU_IMPORT_LOW_CONFIDENCE=70

# CRM sticker mint (PLATFORM_ADMIN) — dev default: DEV-STICKER-OPS-KEY
STICKER_OPS_MINT_KEY=
GUEST_WEB_ORIGIN=http://localhost:3000

# AI routing: hive = thehive.ai V3 key (chat + optional Flux images); deepseek = api.deepseek.com
AI_TEXT_PROVIDER=hive
HIVE_API_KEY=
# HIVE_API_KEY_STAGING=
# HIVE_API_KEY_PRODUCTION=
HIVE_TEXT_MODEL=deepseek-ai/deepseek-v4.1-flash
HIVE_VISION_MODEL=deepseek-ai/deepseek-v4.1-flash
# Menu photo import only — use direct DeepSeek vision when Hive chat “plans” instead of OCR/JSON
# MENU_IMPORT_VISION_PROVIDER=deepseek
HIVE_IMAGE_MODEL=black-forest-labs/flux-schnell

# Poster: live = AI JSON + image (hive Flux or svg fallback)
# live = AI copy; mock = local copy only
POSTER_AI_MODE=live
# hive = Flux photoreal food (needs HIVE_API_KEY); svg = dish-matched stock photo + overlays
POSTER_IMAGE_PROVIDER=hive

# Auto-send scheduled Grow campaigns when scheduledAt is due (mock Kapso)
CAMPAIGN_SCHEDULER_ENABLED=true
CAMPAIGN_SCHEDULER_INTERVAL_MS=15000

PAYMENT_MODE=mock
# PAYMENT_MODE=stub — prepare → confirm-stub / webhooks (local E2E TC-G-058)
# PAYMENT_MODE=razorpay — Checkout.js + POST /checkout/verify-razorpay
# Use Test Mode keys (rzp_test_…) from https://dashboard.razorpay.com/app/keys
# Docs: https://razorpay.com/docs/api · CLI: https://razorpay.com/docs/api/install-cli/
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=  # optional locally; required in prod (raw body HMAC)
