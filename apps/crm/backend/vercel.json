{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @damigos/domain && cd crm/backend && node scripts/bundle-vercel.mjs && test -s api/bundle.mjs && test -s api/otp-verify-bundle.mjs",
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/v1/auth/otp/verify", "destination": "/api/v1/auth/otp/verify" },
    { "source": "/v1/auth/otp/request", "destination": "/api/v1/auth/otp/request" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 },
    "api/v1/auth/otp/verify.js": { "maxDuration": 30 },
    "api/v1/auth/otp/request.js": { "maxDuration": 10 }
  }
}
