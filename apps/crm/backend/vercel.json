{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @damigos/domain && node apps/crm/backend/scripts/bundle-vercel.mjs && test -s apps/crm/backend/api/bundle.mjs",
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/v1/auth/otp/verify", "destination": "/api/v1/auth/otp/verify" },
    { "source": "/v1/auth/otp/request", "destination": "/api/v1/auth/otp/request" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 },
    "api/v1/auth/otp/verify.ts": { "maxDuration": 30 },
    "api/v1/auth/otp/request.ts": { "maxDuration": 10 }
  }
}
