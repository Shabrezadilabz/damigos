{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @damigos/domain",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "env": {
    "NODE_OPTIONS": "--import=tsx"
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{src/**,../../packages/**}"
    }
  }
}
