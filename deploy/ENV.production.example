# Copy to Railway variables (both API services share DATABASE_URL + JWT_SECRET)

DATABASE_URL=postgresql://...
JWT_SECRET=change-me-min-32-chars-for-production
OTP_BYPASS_CODE=000000
ENABLE_DEV_FIXTURES=true
ONBOARDING_AUTO_APPROVE=true
DAMIGOS_ENV=staging

# CRM API service
CRM_CORS_ORIGINS=*
CRM_WEB_URL=https://damigos-crm-web.vercel.app
REDIS_URL=redis://...   # optional — kitchen live refresh

# Guest API service
GUEST_CORS_ORIGINS=*
GUEST_WEB_URL=https://damigos-guest-web.vercel.app

# After Vercel deploy — CRM web project
CRM_API_PROXY_TARGET=https://<crm-api>.up.railway.app
# Or: NEXT_PUBLIC_CRM_API_URL=https://<crm-api>.up.railway.app

# Guest web project (build-time)
NEXT_PUBLIC_GUEST_API_URL=https://<guest-api>.up.railway.app
NEXT_PUBLIC_SHOW_UI_DEMO=true
