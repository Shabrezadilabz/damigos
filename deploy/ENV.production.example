# All Vercel — see docs/DEPLOY-VERCEL-ALL.md

DATABASE_URL=postgresql://...
JWT_SECRET=change-me-min-32-chars-use-same-on-both-api-projects
OTP_BYPASS_CODE=000000
ENABLE_DEV_FIXTURES=true
ONBOARDING_AUTO_APPROVE=true
DAMIGOS_ENV=staging

# damigos-crm-api (Vercel)
CRM_CORS_ORIGINS=*
CRM_WEB_URL=https://damigos-crm-web.vercel.app

# damigos-guest-api (Vercel)
GUEST_CORS_ORIGINS=*
GUEST_WEB_URL=https://damigos-guest-web.vercel.app

# damigos-crm-web
CRM_API_PROXY_TARGET=https://damigos-crm-api.vercel.app

# damigos-guest-web (build-time)
NEXT_PUBLIC_GUEST_API_URL=https://damigos-guest-api.vercel.app
NEXT_PUBLIC_SHOW_UI_DEMO=true
