# Render env (both API services share DATABASE_URL + JWT_SECRET from Blueprint)
# https://dashboard.render.com/

DATABASE_URL=postgresql://...   # from Render Postgres damigos-db
JWT_SECRET=...                  # auto-generated in Blueprint or set manually
OTP_BYPASS_CODE=000000
ENABLE_DEV_FIXTURES=true
ONBOARDING_AUTO_APPROVE=true
DAMIGOS_ENV=staging

# CRM API (damigos-crm-api)
CRM_CORS_ORIGINS=*
CRM_WEB_URL=https://your-crm-app.vercel.app
REDIS_URL=                      # optional Render Key Value

# Guest API (damigos-guest-api)
GUEST_CORS_ORIGINS=*
GUEST_WEB_URL=https://your-guest-app.vercel.app

# Vercel — CRM web project
CRM_API_PROXY_TARGET=https://damigos-crm-api.onrender.com
# Or: NEXT_PUBLIC_CRM_API_URL=https://damigos-crm-api.onrender.com

# Vercel — Guest web project (build-time)
NEXT_PUBLIC_GUEST_API_URL=https://damigos-guest-api.onrender.com
NEXT_PUBLIC_SHOW_UI_DEMO=true
