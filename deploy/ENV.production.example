# Railway (both API services — shared DATABASE_URL + JWT_SECRET)
# https://railway.com/new

DATABASE_URL=postgresql://...
JWT_SECRET=change-me-min-32-chars-use-same-on-both-apis
OTP_BYPASS_CODE=000000
ENABLE_DEV_FIXTURES=true
ONBOARDING_AUTO_APPROVE=true
DAMIGOS_ENV=staging

# CRM API
CRM_CORS_ORIGINS=*
CRM_WEB_URL=https://damigos-crm-web.vercel.app
REDIS_URL=                      # optional

# Guest API
GUEST_CORS_ORIGINS=*
GUEST_WEB_URL=https://damigos-guest-web.vercel.app
# DAMIGOS_SKIP_MIGRATE=1         # optional on guest if CRM already migrates

# Vercel CRM
CRM_API_PROXY_TARGET=https://<crm-api>.up.railway.app

# Vercel Guest (build-time)
NEXT_PUBLIC_GUEST_API_URL=https://<guest-api>.up.railway.app
NEXT_PUBLIC_SHOW_UI_DEMO=true
